{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://software-factory.local/schemas/factory/fitness.schema.json",
  "title": "Fitness rule contract",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "title"],
  "properties": {
    "id": { "type": "string", "pattern": "^FIT-[A-Z0-9][A-Z0-9-]*$" },
    "title": { "type": "string", "minLength": 1 },
    "requirements": {
      "type": "array",
      "items": { "type": "string", "pattern": "^REQ-[A-Z0-9][A-Z0-9-]*$" }
    }
  }
}
