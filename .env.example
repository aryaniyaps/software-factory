DATABASE_URL=postgres://factory:factory@localhost:5432/factory
# Disposable PostgreSQL for Drizzle integration tests (defaults to localhost:5433):
# TEST_DATABASE_URL=postgres://factory:factory@localhost:5433/factory
EVIDENCE_OBJECT_STORE_ROOT=/tmp/software-factory-evidence
EVIDENCE_MAX_INLINE_BYTES=0

# Pi model routing (builtin providers; Codex OAuth from ~/.pi/agent/auth.json).
FACTORY_MODEL_PROVIDER=openai-codex
FACTORY_MODEL=gpt-5.6-luna
# Per-role overrides (optional). Values are concrete model ids for the provider above.
FACTORY_MODEL_PLAN=gpt-5.6-luna
FACTORY_MODEL_IMPLEMENT=gpt-5.6-luna
# FACTORY_MODEL_DISCOVERY_PLAN=
# FACTORY_MODEL_SCOUT=
# FACTORY_MODEL_REPAIR=
# FACTORY_MODEL_REVIEW=
# FACTORY_MODEL_CRITIC=
# Optional override of Pi auth store (defaults to ~/.pi/agent/auth.json):
# PI_AUTH_PATH=
# Optional custom models overlay JSON (builtins used when unset):
# PI_MODELS_PATH=

HINDSIGHT_BASE_URL=http://localhost:8888
HINDSIGHT_API_KEY=
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_MODEL=gpt-4o-mini
HINDSIGHT_API_LLM_API_KEY=
HINDSIGHT_TEMPLATE_PATH=infra/hindsight/factory-bank-template.json
WORKTREE_ROOT=/tmp/software-factory-worktrees
CRABBOX_BIN=crabbox
CRABBOX_SLUG_PREFIX=software-factory
CRABBOX_PROVIDER=local-container
GONDOLIN_EXTENSION_PATH=node_modules/@earendil-works/pi-coding-agent/examples/extensions/gondolin
FACTORY_PORT=8787
FACTORY_HOST=127.0.0.1
FACTORY_A2A_PORT=8788
FACTORY_A2A_HOST=127.0.0.1
FACTORY_A2A_TOKEN=change-me
# FACTORY_A2A_PUBLIC_URL=http://127.0.0.1:8788
# GitHub App used for explicit repository selection and authenticated clones.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_WEBHOOK_SECRET=
# Inline PEM or path to the app private key.
GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_PRIVATE_KEY_PATH=/path/to/private-key.pem
# Optional bootstrap when webhooks cannot reach localhost during local dev.
# GITHUB_APP_INSTALLATION_ID=123456
# GITHUB_API_URL=https://github.example.com/api/v3
# Comma-separated allowlist for HTTPS repository URLs.
FACTORY_REPOSITORY_HOSTS=github.com,gitlab.com
# Required bearer token for API and dashboard requests.
FACTORY_API_TOKEN=change-me
FACTORY_WORKER_MODULE=dist/src/temporal/production-worker.js
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
# Base URL for dashboard deep links written to Temporal workflow memo.
DASHBOARD_BASE_URL=http://localhost:5173
# Dashboard Temporal UI deep links (apps/dashboard reads VITE_* at build time)
VITE_TEMPORAL_UI_URL=http://localhost:8080
VITE_TEMPORAL_NAMESPACE=default
PI_RESOURCE_ROOT=
PI_WEB_SEARCH_PROVIDERS=openai,brave,exa,tavily,kagi
FACTORY_ORGANIZATION=local
FACTORY_PROJECT=software-factory
FACTORY_IMAGE=software-factory-local:dev
FACTORY_PROVENANCE_SIGNING_KEY=factory-dev-signing-key
FACTORY_ARTIFACT_DIGEST=
FACTORY_DEPLOYMENT_PROFILE=staging
# Placeholders so the worker can start; real release needs a reachable deploy target.
FACTORY_DEPLOY_HOST=127.0.0.1
FACTORY_HEALTH_URL=http://127.0.0.1:9999/health
FACTORY_PREVIOUS_DIGEST=
REPOSITORY_CACHE_ROOT=/tmp/software-factory-repositories
# Optional when running `npm run compose:obs`:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:6006
# OTEL_SERVICE_NAME=software-factory
# OTEL_METRICS_EXPORTER_OTLP_ENDPOINT=
CONTEXT7_MCP_URL=https://mcp.context7.com/mcp
CONTEXT7_API_KEY=
WEB_SEARCH_URL=
WEB_SEARCH_API_KEY=
