DATABASE_URL=postgres://factory:factory@localhost:5432/factory
# Disposable PostgreSQL for Drizzle integration tests (defaults to localhost:5433):
# TEST_DATABASE_URL=postgres://factory:factory@localhost:5433/factory
EVIDENCE_OBJECT_STORE_ROOT=/tmp/software-factory-evidence
EVIDENCE_MAX_INLINE_BYTES=0
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=
# Quick start: one model for all roles (factory/default).
FACTORY_MODEL=
FACTORY_MODEL_API_KEY=
# Per-role overrides (optional). When set, that role uses its factory/<role> alias instead of factory/default.
# Aptness hints: scout = faster/cheaper; plan/repair/review/critic = stronger reasoning; implement = strong coding.
# FACTORY_MODEL_SCOUT=
# FACTORY_MODEL_SCOUT_API_KEY=
# FACTORY_MODEL_PLAN=
# FACTORY_MODEL_PLAN_API_KEY=
# FACTORY_MODEL_IMPLEMENT=
# FACTORY_MODEL_IMPLEMENT_API_KEY=
# FACTORY_MODEL_REPAIR=
# FACTORY_MODEL_REPAIR_API_KEY=
# FACTORY_MODEL_REVIEW=
# FACTORY_MODEL_REVIEW_API_KEY=
# FACTORY_MODEL_CRITIC=
# FACTORY_MODEL_CRITIC_API_KEY=
PI_MODELS_PATH=infra/pi/models.json
HINDSIGHT_BASE_URL=http://localhost:8888
HINDSIGHT_API_KEY=
HINDSIGHT_TEMPLATE_PATH=infra/hindsight/factory-bank-template.json
WORKTREE_ROOT=/tmp/software-factory-worktrees
CRABBOX_BIN=crabbox
CRABBOX_SLUG_PREFIX=software-factory
GONDOLIN_EXTENSION_PATH=node_modules/@earendil-works/pi-coding-agent/examples/extensions/gondolin
FACTORY_PORT=8787
# Optional: require Bearer token on write routes (POST /tasks, cancel, etc.)
# FACTORY_API_TOKEN=
FACTORY_WORKER_MODULE=dist/temporal/production-worker.js
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
PI_RESOURCE_ROOT=/opt/software-factory/pi-resources
PI_WEB_SEARCH_PROVIDERS=openai,brave,exa,tavily,kagi
FACTORY_ORGANIZATION=
FACTORY_PROJECT=
FACTORY_IMAGE=
FACTORY_PROVENANCE_SIGNING_KEY=
FACTORY_ARTIFACT_DIGEST=
FACTORY_DEPLOYMENT_PROFILE=staging
FACTORY_DEPLOY_HOST=
FACTORY_HEALTH_URL=
FACTORY_PREVIOUS_DIGEST=
REPOSITORY_CACHE_ROOT=/tmp/software-factory-repositories
# Optional when running `npm run compose:obs`:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:6006
# OTEL_SERVICE_NAME=software-factory
# OTEL_METRICS_EXPORTER_OTLP_ENDPOINT=
CONTEXT7_MCP_URL=https://mcp.context7.com/mcp
